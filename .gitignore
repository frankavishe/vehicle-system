# --- Python / Django ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python
build/
dist/
*.sqlite3
.env
backend/secrets/*
!backend/secrets/.gitkeep
.pytest_cache/
.coverage
htmlcov/
staticfiles/
media/
# celery beat's own schedule-state file (config/settings/base.py's
# CELERY_BEAT_SCHEDULE, Phase 4) — a runtime DB, not source.
celerybeat-schedule*

# --- Node / Next.js (web/, Phase 2+) ---
node_modules/
.next/
out/
web/.env*.local

# --- Flutter / Dart (mobile/, Phase 3+) ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/**/ios/Pods/
mobile/**/android/.gradle/
*.iml

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Docker ---
infra/.env

# --- Secrets / keys (Firebase service-account, APNs, mobile configs,
# TLS/signing keys — Phase 1-4 per PLAN.md §5.4/§7) ---
.env.local
.env.*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
**/google-services.json
**/GoogleService-Info.plist

# --- Docs (spec PDF, planning/tracking markdown) ---
*.pdf
*.md
# ...except standard package docs that are normally committed, not the
# root-level planning/tracking docs (PLAN.md/phase.md/work.md) this rule
# exists for. web/AGENTS.md is Next.js 16's own generated agent-guidance
# file — it explicitly asks to be committed (see work.md, 2026-08-20).
!web/README.md
!web/AGENTS.md
!web/CLAUDE.md
!mobile/README.md
!infra/osrm/README.md

# --- Phase 4: OSRM Tanzania extract — downloaded/processed locally per
# infra/osrm/README.md, never committed (hundreds of MB). ---
infra/osrm/data/
