# Copy to web/.env (gitignored) — Next.js loads .env automatically for
# both `npm run dev` and the Docker image, same pattern as
# backend/.env.example. infra/docker-compose.yml's `web` service reads
# this file via its own env_file entry.

# --- Core ---
# Server-only — never sent to the browser. How the Next.js server reaches
# Django: the compose service name inside Docker, localhost otherwise.
BACKEND_INTERNAL_URL=http://localhost:8000

# --- Phase 3/4: Firebase web push (see PLAN.md §5.4) ---
# Human account-setup action item, same one backend/.env.example already
# lists for FCM. Firebase web config values are meant to be public (not
# secrets — access is enforced by Firebase security rules, not by hiding
# these), hence the NEXT_PUBLIC_ prefix. Until these are filled in,
# src/lib/firebase.ts's isFirebaseConfigured stays false and every push
# code path no-ops (see src/components/PushRegistration.tsx).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
