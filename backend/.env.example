# Copy to backend/.env (gitignored).

# --- Core ---
DEBUG=True
SECRET_KEY=dev-only-secret-key-not-for-prod-change-me-1234567890
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgis://autoserve:autoserve@db:5432/autoserve
REDIS_URL=redis://redis:6379/0
DEFAULT_CURRENCY=TZS
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Phase 2/4: Flutterwave + Selcom (dual-gateway, see PLAN.md §5.3/§8) ---
# Human account-setup action item — PLAN.md §7 Phase 1 checklist.
# No integration code reads these yet (Phase 2-4).
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_WEBHOOK_SECRET=
SELCOM_BASE_URL=https://apigw.selcommobile.com

# --- Phase 3/4: Firebase Cloud Messaging + web push (see PLAN.md §5.4) ---
# Human account-setup action item — PLAN.md §7 Phase 1 checklist.
# Phase 3 reads these (apps/notifications/services/fcm.py) — no-op-safe
# until a real service-account JSON exists at the path below.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_WEB_VAPID_PUBLIC_KEY=

# --- Phase 3: Beem Africa SMS fallback, dispatch-critical only (see PLAN.md §5.4) ---
# Human account-setup action item — PLAN.md §7 Phase 1 checklist.
# Phase 3 reads these (apps/notifications/services/beem.py) — no-op-safe
# until real credentials + an approved Sender ID exist.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_VENDOR_ID=
BEEM_SENDER_ID=
BEEM_BASE_URL=https://apisms.beem.africa

# --- Phase 3: Celery (broker only, no result backend) ---
CELERY_TASK_ALWAYS_EAGER=False

# --- Phase 3: apps.dispatch radius matching (PLAN.md §5.1) ---
DISPATCH_MAX_RADIUS_KM=50
