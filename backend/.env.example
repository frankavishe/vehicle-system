# Copy to backend/.env (gitignored).

# --- Core ---
DEBUG=True
SECRET_KEY=dev-only-secret-key-not-for-prod-change-me-1234567890
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgis://autoserve:autoserve@db:5432/autoserve
REDIS_URL=redis://redis:6379/0
DEFAULT_CURRENCY=TZS
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 2/4: Flutterwave + Selcom (dual-gateway, see PLAN.md §5.3/§8) ---
# Human account-setup action item — PLAN.md §7 Phase 1 checklist.
